# Скопируй этот файл в .env и задай свои значения.
# .env НЕ должен попадать в git (уже в .gitignore).
#
# Генерация JWT_SECRET:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Секрет для подписи JWT-токенов. Обязательно задай своё значение.
JWT_SECRET=REPLACE_WITH_YOUR_OWN_STRONG_SECRET_SEE_COMMENT_ABOVE

# Пароль администратора (admin). При смене — перезапусти контейнер backend.
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Разрешённые источники для браузерных запросов (CORS).
# В production замени на реальный домен. Несколько — через запятую.
# По умолчанию (если не задан) — любой источник (*), небезопасно для prod.
CORS_ORIGINS=https://pm.simbad.pro
